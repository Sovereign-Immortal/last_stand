[gd_scene format=3 uid="uid://game_over_scene"]

[ext_resource type="Script" path="res://Scenes/UI/game_over.gd" id="1_go"]
[ext_resource type="StyleBox" uid="uid://dgyrm4qtxfd75" path="res://btn styles/menue buttons.tres" id="2_go"]
[ext_resource type="Texture2D" path="res://Last Stand Assets/UI/game_over_bg.jpg" id="3_bg"]

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_go")

; Game over background image
[node name="BG" type="TextureRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_bg")
expand_mode = 1
stretch_mode = 6

[node name="VBox" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(220, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -110.0
offset_top = -90.0
offset_right = 110.0
offset_bottom = 90.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10
alignment = 1

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.1, 0.1, 1)
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
text = "YOU DIED"

[node name="ScoreLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1.0, 0.92, 0.2, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1
text = "SCORE  000000"

[node name="WaveLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
text = "WAVE REACHED  1"

[node name="HiScoreLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 1.0, 0.5, 1)
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1
text = "BEST  000000"

[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)

[node name="RetryButton" type="Button" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.44, 0.14, 1)
theme_override_colors/font_hover_color = Color(0.95, 0.95, 0.95, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = ExtResource("2_go")
action_mode = 0
text = "RETRY"

[node name="MenuButton" type="Button" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.44, 0.14, 1)
theme_override_colors/font_hover_color = Color(0.95, 0.95, 0.95, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = ExtResource("2_go")
action_mode = 0
text = "MENU"

[connection signal="pressed" from="VBox/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="VBox/MenuButton" to="." method="_on_menu_pressed"]
