; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Last Stand"
run/main_scene="res://Scenes/UI/splash_screen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="res://Last Stand Assets/UI/mad_scientist_splash.png"
config/icon="res://icon.svg"

[autoload]

Globals="*uid://df6d8vj06aieo"
AudioManager="*res://Globals/audio_manager.gd"
SceneTransition="*res://Globals/scene_transition.gd"
DialogManager="*res://Globals/dialog_manager.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=4
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

